diff --git a/WSLGd/Compositor.h b/WSLGd/Compositor.h
new file mode 100644
index 0000000..ce0fe42
--- /dev/null
+++ b/WSLGd/Compositor.h
@@ -0,0 +1,88 @@
+// BunOS patch: compositor selection for WSLGd. Header-only and free of WSLG/winpr
+// dependencies so it can be unit-tested on any Linux host (see tests/compositor_test.cpp).
+#pragma once
+#include <cctype>
+#include <string>
+#include <vector>
+
+namespace wslgd
+{
+    // WSL2_COMPOSITOR (settable in .wslgconfig [system-distro-env]).
+    //   weston            Weston RDP backend + rdprail-shell (upstream behaviour, default).
+    //   hyprland-nested   Weston as before, plus Hyprland as a Wayland client of it
+    //                     (aquamarine wayland backend); Hyprland listens on wayland-1.
+    //   hyprland-headless Weston as before for the Windows side, plus Hyprland on its
+    //                     headless backend. No RDP bridge exists: see docs/BUNOS-PATCHES.md.
+    enum class CompositorMode
+    {
+        Weston,
+        HyprlandNested,
+        HyprlandHeadless,
+        Invalid,
+    };
+
+    inline CompositorMode ParseCompositorMode(const char* value)
+    {
+        if (value == nullptr || *value == '\0') {
+            return CompositorMode::Weston;
+        }
+
+        std::string v(value);
+        for (auto& c : v) {
+            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        }
+
+        if (v == "weston") {
+            return CompositorMode::Weston;
+        }
+        if (v == "hyprland-nested") {
+            return CompositorMode::HyprlandNested;
+        }
+        if (v == "hyprland-headless") {
+            return CompositorMode::HyprlandHeadless;
+        }
+        return CompositorMode::Invalid;
+    }
+
+    inline const char* CompositorModeName(CompositorMode mode)
+    {
+        switch (mode) {
+        case CompositorMode::Weston: return "weston";
+        case CompositorMode::HyprlandNested: return "hyprland-nested";
+        case CompositorMode::HyprlandHeadless: return "hyprland-headless";
+        default: return "invalid";
+        }
+    }
+
+    inline bool IsHyprland(CompositorMode mode)
+    {
+        return mode == CompositorMode::HyprlandNested || mode == CompositorMode::HyprlandHeadless;
+    }
+
+    // argv of the Hyprland launch. dbus-run-session gives Hyprland a session bus.
+    inline std::vector<std::string> HyprlandCommand(const std::string& configPath)
+    {
+        return {"/usr/bin/dbus-run-session", "--", "/usr/bin/Hyprland", "--config", configPath};
+    }
+
+    // Config file for the mode, relative to the system distro /etc/wslg.
+    inline std::string HyprlandConfigPath(CompositorMode mode)
+    {
+        return mode == CompositorMode::HyprlandHeadless ? "/etc/wslg/hyprland-headless.lua"
+                                                        : "/etc/wslg/hyprland-nested.lua";
+    }
+
+    // Extra environment (NAME=value) for the Hyprland process, on top of WSLGd's own.
+    //  nested:   host compositor is Weston's wayland-0 (aquamarine wayland backend).
+    //  headless: WAYLAND_DISPLAY must be empty so aquamarine does not pick its wayland
+    //            fallback backend; an empty entry is skipped by ProcessMonitor, so the
+    //            variable is explicitly set to the empty string by the caller via unsetenv.
+    inline std::vector<std::string> HyprlandEnv(CompositorMode mode, const std::string& hostWaylandDisplay)
+    {
+        std::vector<std::string> env{"XDG_CURRENT_DESKTOP=Hyprland", "XDG_SESSION_TYPE=wayland"};
+        if (mode == CompositorMode::HyprlandNested) {
+            env.push_back("WAYLAND_DISPLAY=" + hostWaylandDisplay);
+        }
+        return env;
+    }
+}
diff --git a/WSLGd/main.cpp b/WSLGd/main.cpp
index accd831..ee8ffb0 100644
--- a/WSLGd/main.cpp
+++ b/WSLGd/main.cpp
@@ -4,6 +4,7 @@
 #include "common.h"
 #include "ProcessMonitor.h"
 #include "FontMonitor.h"
+#include "Compositor.h"
 
 #define CONFIG_FILE ".wslgconfig"
 #define MSRDC_EXE "msrdc.exe"
@@ -41,6 +42,8 @@ constexpr auto c_westonShellDesktopEnv = "WSL2_WESTON_SHELL_DESKTOP";
 constexpr auto c_westonRdprailShell = "rdprail-shell";
 constexpr auto c_westonRdpdesktopShell = "desktop-shell";
 
+constexpr auto c_compositorEnv = "WSL2_COMPOSITOR";
+
 constexpr auto c_rdpRailFile = "wslg.rdp";
 constexpr auto c_rdpDesktopFile = "wslg_desktop.rdp";
 
@@ -211,6 +214,19 @@ void WaitForReadyNotify(int notifyFd)
     THROW_LAST_ERROR_IF(!fd);
 }
 
+// True when a DRM render node exists. aquamarine (Hyprland) allocates through GBM on a DRM
+// node; WSL2 normally exposes only /dev/dxg, so Hyprland modes need one provided by the kernel.
+bool HasDrmRenderNode()
+{
+    std::error_code ec;
+    for (const auto& entry : std::filesystem::directory_iterator("/dev/dri", ec)) {
+        if (entry.path().filename().string().rfind("renderD", 0) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
 int main(int Argc, char *Argv[])
 try {
     wil::g_LogExceptionCallback = LogException;
@@ -249,6 +265,25 @@ try {
 
     SetupOptionalEnv();
 
+    // BunOS: compositor selection (weston | hyprland-nested | hyprland-headless).
+    auto compositorMode = wslgd::ParseCompositorMode(getenv(c_compositorEnv));
+    if (compositorMode == wslgd::CompositorMode::Invalid) {
+        LOG_ERROR("%s=%s is not one of weston, hyprland-nested, hyprland-headless; using weston.",
+                  c_compositorEnv, getenv(c_compositorEnv));
+        compositorMode = wslgd::CompositorMode::Weston;
+    }
+    if (wslgd::IsHyprland(compositorMode) && access("/usr/bin/Hyprland", X_OK) != 0) {
+        LOG_ERROR("%s=%s but /usr/bin/Hyprland is not installed; using weston.",
+                  c_compositorEnv, wslgd::CompositorModeName(compositorMode));
+        compositorMode = wslgd::CompositorMode::Weston;
+    }
+    if (wslgd::IsHyprland(compositorMode) && !HasDrmRenderNode()) {
+        LOG_ERROR("%s=%s needs a DRM render node (aquamarine GBM allocator) and /dev/dri has none; using weston.",
+                  c_compositorEnv, wslgd::CompositorModeName(compositorMode));
+        compositorMode = wslgd::CompositorMode::Weston;
+    }
+    LOG_INFO("compositor mode: %s", wslgd::CompositorModeName(compositorMode));
+
     // if any components output log to /dev/kmsg, make it writable.
     if (GetEnvBool("WSLG_LOG_KMSG", false))
         THROW_LAST_ERROR_IF(chmod("/dev/kmsg", 0666) < 0);
@@ -451,6 +486,26 @@ try {
     WaitForReadyNotify(notifyFd.get());
     unlink(WESTON_NOTIFY_SOCKET);
 
+    // BunOS: Hyprland runs next to the Weston RDP/RAIL stack, which still owns the Windows side
+    // (RDP connection, PulseAudio sinks, app list). Nested: Hyprland is a Wayland client of
+    // wayland-0 and serves wayland-1. Headless: no host compositor is visible to aquamarine.
+    if (wslgd::IsHyprland(compositorMode)) {
+        std::vector<std::string> hyprlandEnv =
+            wslgd::HyprlandEnv(compositorMode, getenv("WAYLAND_DISPLAY"));
+        hyprlandEnv.emplace_back(std::string("WSLG_COMPOSITOR=") + wslgd::CompositorModeName(compositorMode));
+        if (compositorMode == wslgd::CompositorMode::HyprlandHeadless) {
+            // ProcessMonitor appends to environ, so the inherited value has to be removed.
+            unsetenv("WAYLAND_DISPLAY");
+        }
+        monitor.LaunchProcess(
+            wslgd::HyprlandCommand(wslgd::HyprlandConfigPath(compositorMode)),
+            std::vector<cap_value_t>{},
+            std::move(hyprlandEnv));
+        if (compositorMode == wslgd::CompositorMode::HyprlandHeadless) {
+            setenv("WAYLAND_DISPLAY", "wayland-0", true);
+        }
+    }
+
     // Start font monitoring if user distro's X11 fonts to be shared with system distro.
     if (GetEnvBool("WSLG_USE_USER_DISTRO_XFONTS", true))
         fontMonitor.Start(); 
