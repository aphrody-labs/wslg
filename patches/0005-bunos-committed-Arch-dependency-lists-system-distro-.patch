+#!/usr/bin/env bash
+# Regenerate patches/ (git format-patch series) from upstream/main..HEAD.
+# Commits and hunks that only touch patches/ or the patch-queue docs are excluded, so the
+# series describes the code changes only. usage: bunos/regen-patches.sh [base-ref]
+set -euo pipefail
+cd "$(git rev-parse --show-toplevel)"
+base=${1:-upstream/main}
+git rev-parse --verify -q "$base" >/dev/null || { echo "missing $base; git fetch upstream main" >&2; exit 1; }
+rm -rf patches
+mkdir patches
+git format-patch --no-signature --zero-commit -o patches "$base"..HEAD -- . \
+  ':(exclude)patches' ':(exclude)docs/BUNOS-PATCHES.md' >/dev/null
+( cd patches && ls -1 *.patch > series )
+echo "wrote $(wc -l < patches/series) patches against $(git rev-parse --short "$base")"
+cat patches/series
diff --git a/bunos/verify-patches.sh b/bunos/verify-patches.sh
new file mode 100644
index 0000000..f6516b7
--- /dev/null
+++ b/bunos/verify-patches.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+# Apply patches/ with `git am` on top of the current microsoft/wslg main in a scratch clone.
+# A failure means upstream moved and the queue needs a rebase (docs/BUNOS-PATCHES.md).
+set -euo pipefail
+here=$(cd "$(dirname "$0")/.." && pwd)
+tmp=$(mktemp -d)
+git clone -q --depth 1 https://github.com/microsoft/wslg "$tmp"
+git -C "$tmp" log -1 --format='upstream main: %H'
+git -C "$tmp" -c user.name=ci -c user.email=ci@invalid am --quiet "$here"/patches/*.patch
+echo "all $(wc -l < "$here/patches/series") patches apply"
