From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aphrody-dev <contact@aphrody.com>
Date: Thu, 29 Oct 2026 05:36:39 +0100
Subject: [PATCH 09/13] bunos: build hyprwire v0.3.1 (required by Hyprland
 0.57.0), fetch udis86 submodule, drop .so provides from package lists

---
 bunos/Dockerfile        | 5 +++--
 bunos/check-versions.sh | 1 +
 bunos/deps/hyprwire.txt | 9 +++++++++
 bunos/deps/list.sh      | 2 +-
 bunos/deps/regen.sh     | 2 +-
 bunos/sources.json      | 6 ++++++
 bunos/versions.env      | 3 +++
 7 files changed, 24 insertions(+), 4 deletions(-)
 create mode 100644 bunos/deps/hyprwire.txt

diff --git a/bunos/Dockerfile b/bunos/Dockerfile
index d57037d..2756d55 100644
--- a/bunos/Dockerfile
+++ b/bunos/Dockerfile
@@ -72,7 +72,7 @@ RUN . /opt/bunos/versions.env \
 FROM weston AS hyprland
 RUN . /opt/bunos/versions.env \
  && pacman -S --noconfirm --needed --asdeps \
-      $(bash /opt/bunos/deps/list.sh hyprland aquamarine hyprcursor hyprgraphics hyprlang hyprutils hyprwayland-scanner) \
+      $(bash /opt/bunos/deps/list.sh hyprland hyprwire aquamarine hyprcursor hyprgraphics hyprlang hyprutils hyprwayland-scanner) \
  && clone() { git clone --depth 1 -b "$2" "https://github.com/hyprwm/$1.git" "$1" \
               && test "$(git -C "$1" rev-parse HEAD)" = "$3"; } \
  && cm() { cmake -S "$1" -B "$1/build" -G Ninja -DCMAKE_BUILD_TYPE=Release \
@@ -87,8 +87,9 @@ RUN . /opt/bunos/versions.env \
  && clone hyprgraphics "$HYPRGRAPHICS_TAG" "$HYPRGRAPHICS_SHA" && cm hyprgraphics \
  && clone aquamarine "$AQUAMARINE_TAG" "$AQUAMARINE_SHA" \
  && git -C aquamarine apply /opt/bunos/patches/aquamarine-*.patch && cm aquamarine \
+ && clone hyprwire "$HYPRWIRE_TAG" "$HYPRWIRE_SHA" && cm hyprwire \
  && ldconfig \
- && git clone --depth 1 -b "$HYPRLAND_TAG" https://github.com/hyprwm/Hyprland.git Hyprland \
+ && git clone --depth 1 --recurse-submodules --shallow-submodules -b "$HYPRLAND_TAG" https://github.com/hyprwm/Hyprland.git Hyprland \
  && test "$(git -C Hyprland rev-parse HEAD)" = "$HYPRLAND_SHA" \
  && cm Hyprland -DNO_TESTS=ON -DNO_HYPRPM=ON -DNO_UWSM=ON -DNO_SYSTEMD=ON -DBUILD_TESTING=OFF \
  && ldconfig
diff --git a/bunos/check-versions.sh b/bunos/check-versions.sh
index 5d27714..d275ebe 100644
--- a/bunos/check-versions.sh
+++ b/bunos/check-versions.sh
@@ -15,6 +15,7 @@ declare -A URL=(
   [HYPRGRAPHICS]=https://github.com/hyprwm/hyprgraphics.git
   [HYPRWAYLAND_SCANNER]=https://github.com/hyprwm/hyprwayland-scanner.git
   [HYPRLAND_PROTOCOLS]=https://github.com/hyprwm/hyprland-protocols.git
+  [HYPRWIRE]=https://github.com/hyprwm/hyprwire.git
   [WAYLAND]=https://gitlab.freedesktop.org/wayland/wayland.git
   [WAYLAND_PROTOCOLS]=https://gitlab.freedesktop.org/wayland/wayland-protocols.git
   [XWAYLAND_CANDIDATE]=https://gitlab.freedesktop.org/xorg/xserver.git
diff --git a/bunos/deps/hyprwire.txt b/bunos/deps/hyprwire.txt
new file mode 100644
index 0000000..117ab28
--- /dev/null
+++ b/bunos/deps/hyprwire.txt
@@ -0,0 +1,9 @@
+# Arch hyprwire 0.3.1-3 depends+makedepends, 2026-10-29
+cmake
+glibc
+libffi
+libffi.so
+libgcc
+libhyprutils.so
+libstdc++
+pugixml
diff --git a/bunos/deps/list.sh b/bunos/deps/list.sh
index b8f4596..127d1d2 100644
--- a/bunos/deps/list.sh
+++ b/bunos/deps/list.sh
@@ -2,4 +2,4 @@
 # Print the package names of the committed dependency lists (comments and ambiguous virtuals dropped).
 set -eu
 cd "$(dirname "$0")"
-for p in "$@"; do cat "$p.txt"; done | grep -v '^#' | grep -vx 'opengl-driver' | sort -u
+for p in "$@"; do cat "$p.txt"; done | grep -v '^#' | grep -vx 'opengl-driver' | grep -v '.so$' | sort -u
diff --git a/bunos/deps/regen.sh b/bunos/deps/regen.sh
index d31b616..a51973c 100644
--- a/bunos/deps/regen.sh
+++ b/bunos/deps/regen.sh
@@ -3,7 +3,7 @@
 # CI does not call this: gitlab.archlinux.org may challenge datacenter IPs, so the lists are committed.
 set -euo pipefail
 cd "$(dirname "$0")"
-for pkg in xorg-xwayland weston hyprland aquamarine hyprcursor hyprgraphics hyprlang hyprutils hyprwayland-scanner; do
+for pkg in xorg-xwayland weston hyprland hyprwire aquamarine hyprcursor hyprgraphics hyprlang hyprutils hyprwayland-scanner; do
   curl -fsSL "https://gitlab.archlinux.org/archlinux/packaging/packages/${pkg}/-/raw/main/PKGBUILD" -o /tmp/PKGBUILD.$pkg
   ver=$( ( set +eu; source /tmp/PKGBUILD.$pkg >/dev/null 2>&1; echo "$pkgver-$pkgrel" ) )
   { echo "# Arch $pkg $ver depends+makedepends, $(date -u +%F)"; ../arch-deps.sh "$pkg"; } > "$pkg.txt"
diff --git a/bunos/sources.json b/bunos/sources.json
index 58072c9..1ed940f 100644
--- a/bunos/sources.json
+++ b/bunos/sources.json
@@ -96,6 +96,12 @@
   "hyprland-guiutils": {
    "tag": "v0.2.2",
    "note": "latest tag, not built (optional GUI helper)"
+  },
+  "hyprwire": {
+   "tag": "v0.3.1",
+   "sha": "3e6865ce5fd9237b58f5b2ce5de18814df3baff5",
+   "commit_date": "2026-04-25T23:30:02Z",
+   "url": "https://github.com/hyprwm/hyprwire"
   }
  }
 }
\ No newline at end of file
diff --git a/bunos/versions.env b/bunos/versions.env
index cfd193f..c456782 100644
--- a/bunos/versions.env
+++ b/bunos/versions.env
@@ -33,3 +33,6 @@ WAYLAND_PROTOCOLS_SHA=ee78491a237eaff9389a0ccf8680521d074407d3
 # Xwayland candidate (26.1 RC line); the Dockerfile ARG XWAYLAND_TAG/XWAYLAND_SHA override the stable pin.
 XWAYLAND_CANDIDATE_TAG=xwayland-26.0.99.903
 XWAYLAND_CANDIDATE_SHA=c9d66306371c68e23923ceaa2dc3aa1ba97e7163
+# Required by Hyprland v0.57.0 (hyprctl/start pkg-config check "hyprutils;hyprwire;re2;readline"); found by the CI build.
+HYPRWIRE_TAG=v0.3.1
+HYPRWIRE_SHA=3e6865ce5fd9237b58f5b2ce5de18814df3baff5
