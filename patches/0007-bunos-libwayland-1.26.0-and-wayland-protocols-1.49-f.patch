From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aphrody-dev <contact@aphrody.com>
Date: Thu, 29 Oct 2026 05:28:46 +0100
Subject: [PATCH 07/13] bunos: libwayland 1.26.0 and wayland-protocols 1.49
 from source, Xwayland stable/RC matrix, sources.json, RAIL port
 classification, weston-info probe, fix invalid weston option

---
 .github/workflows/bunos-wslg.yml            |  28 ++++++
 bunos/Dockerfile                            |  23 ++++-
 bunos/check-versions.sh                     |   3 +
 bunos/evidence/rail-port-classification.tsv |  65 +++++++++++++
 bunos/probes/run-probes.sh                  |   5 +
 bunos/sources.json                          | 101 ++++++++++++++++++++
 bunos/versions.env                          |   8 ++
 7 files changed, 230 insertions(+), 3 deletions(-)
 create mode 100644 bunos/evidence/rail-port-classification.tsv
 create mode 100644 bunos/sources.json

diff --git a/.github/workflows/bunos-wslg.yml b/.github/workflows/bunos-wslg.yml
index c96c8a2..542e8b0 100644
--- a/.github/workflows/bunos-wslg.yml
+++ b/.github/workflows/bunos-wslg.yml
@@ -113,6 +113,34 @@ jobs:
           path: bunos-usr-local.tar.gz
           compression-level: 0
 
+  xwayland-candidate:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - name: stable
+            tag: xwayland-24.1.14
+            sha: d958b4e84c903e8d5851b5ea587b998e4834ce62
+          - name: rc-26.1
+            tag: xwayland-26.0.99.903
+            sha: c9d66306371c68e23923ceaa2dc3aa1ba97e7163
+    name: xwayland-${{ matrix.name }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: docker/setup-buildx-action@v3
+      - name: Build libwayland 1.26.0 + wayland-protocols 1.49 + Xwayland ${{ matrix.tag }}
+        run: |
+          docker build -f bunos/Dockerfile --target xwayland             --build-arg XW_TAG=${{ matrix.tag }} --build-arg XW_SHA=${{ matrix.sha }} -t xw:${{ matrix.name }} .
+      - name: Versions
+        run: |
+          docker run --rm xw:${{ matrix.name }} sh -c 'Xwayland -version 2>&1 | head -3; pkg-config --modversion wayland-server wayland-protocols' | tee xwayland-${{ matrix.name }}.txt
+      - uses: actions/upload-artifact@v4
+        with:
+          name: xwayland-${{ matrix.name }}
+          path: xwayland-${{ matrix.name }}.txt
+
   system-distro:
     needs: unit
     if: (github.event_name == 'workflow_dispatch' && inputs.system_distro) || contains(github.event.head_commit.message, '[distro]')
diff --git a/bunos/Dockerfile b/bunos/Dockerfile
index d659455..ccb4430 100644
--- a/bunos/Dockerfile
+++ b/bunos/Dockerfile
@@ -20,9 +20,26 @@ COPY bunos/deps/ /opt/bunos/deps/
 COPY bunos/patches/ /opt/bunos/patches/
 WORKDIR /src
 
-# ---------------------------------------------------------------- Xwayland (xwayland-shell)
-FROM base AS xwayland
+# ---------------------------------------------------------------- libwayland + wayland-protocols
+FROM base AS wayland
 RUN . /opt/bunos/versions.env \
+ && git clone --depth 1 -b "${WAYLAND_TAG}" https://gitlab.freedesktop.org/wayland/wayland.git wayland \
+ && test "$(git -C wayland rev-parse HEAD)" = "${WAYLAND_SHA}" \
+ && meson setup wayland/build wayland --prefix=/usr/local --libdir=lib --buildtype=release \
+      -Ddocumentation=false -Dtests=false -Ddtd_validation=false \
+ && ninja -C wayland/build install \
+ && git clone --depth 1 -b "${WAYLAND_PROTOCOLS_TAG}" https://gitlab.freedesktop.org/wayland/wayland-protocols.git wlp \
+ && test "$(git -C wlp rev-parse HEAD)" = "${WAYLAND_PROTOCOLS_SHA}" \
+ && meson setup wlp/build wlp --prefix=/usr/local --libdir=lib -Dtests=false \
+ && ninja -C wlp/build install && ldconfig
+
+# ---------------------------------------------------------------- Xwayland (xwayland-shell)
+# XW_TAG/XW_SHA build args override the pins; they default to the stable line; CI also builds the 26.1 RC candidate.
+FROM wayland AS xwayland
+ARG XW_TAG=
+ARG XW_SHA=
+RUN . /opt/bunos/versions.env \
+ && XWAYLAND_TAG=${XW_TAG:-$XWAYLAND_TAG} && XWAYLAND_SHA=${XW_SHA:-$XWAYLAND_SHA} \
  && pacman -S --noconfirm --needed --asdeps $(bash /opt/bunos/deps/list.sh xorg-xwayland) \
  && git clone --depth 1 -b "${XWAYLAND_TAG}" https://gitlab.freedesktop.org/xorg/xserver.git xserver \
  && test "$(git -C xserver rev-parse HEAD)" = "${XWAYLAND_SHA}" \
@@ -44,7 +61,7 @@ RUN . /opt/bunos/versions.env \
       -Dxwayland=true -Dxwayland-path=/usr/local/bin/Xwayland \
       -Dshell-desktop=true -Dshell-ivi=false -Dshell-kiosk=false -Dshell-lua=false \
       -Dsystemd=false -Dcolor-management-lcms=false -Dimage-jpeg=true -Dimage-webp=false \
-      -Dpipewire=false -Ddeprecated-pipewire=false -Ddeprecated-remoting=false \
+      -Ddeprecated-pipewire=false -Ddeprecated-remoting=false \
       -Dsimple-clients=shm,egl,damage -Dtools=info -Ddemo-clients=false \
       -Dtests=false -Ddoc=false \
  && ninja -C weston/build install
diff --git a/bunos/check-versions.sh b/bunos/check-versions.sh
index 6618046..5d27714 100644
